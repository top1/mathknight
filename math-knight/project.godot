; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MathKnight"
run/main_scene="res://scenes/menu/TitleScreen.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/main_scene="res://scenes/menu/TitleScreen.tscn"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
MathEngine="*res://scripts/autoload/MathEngine.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
RunManager="*res://scripts/autoload/RunManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SpriteManager="*res://scripts/autoload/SpriteManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

[gui]

theme/custom_font="res://assets/fonts/Silkscreen-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
